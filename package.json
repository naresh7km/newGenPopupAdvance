{
    "name": "newgenpopup-server",
    "version": "1.0.0",
    "description": "Node.js server to validate Japanese timezone and track GCLIDs via Redis",
    "main": "server.js",
    "scripts": {
      "start": "node server.js",
      "dev": "nodemon server.js"
    },
    "dependencies": {
      "@aws-sdk/client-s3": "^3.1032.0",
      "@aws-sdk/client-s3-control": "^3.1032.0",
      "@aws-sdk/s3-request-presigner": "^3.1032.0",
      "cors": "^2.8.5",
      "crypto-js": "^4.2.0",
      "dotenv": "^17.4.2",
      "express": "^4.18.2",
      "ioredis": "^5.3.2",
      "uuid": "^13.0.0"
    },
    "devDependencies": {
      "nodemon": "^3.0.1"
    },
    "_envVars": {
      "required": [
        "REDIS_URL",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "ENCRYPTION_KEY",
        "AWS_REGION",
        "AWS_ACCOUNT_ID",
        "BUCKET_NAME"
      ],
      "optional": [
        "AMPLIFY_URL_FALLBACK",
        "OBJECT_KEY",
        "PORT",
        "IPAPI_IS_KEY"
      ]
    }
  }
  